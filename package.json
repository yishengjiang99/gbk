{
  "name": "sf2-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:midi-manifest": "node scripts/generate-midi-manifest.mjs",
    "dev": "npm run gen:midi-manifest && vite",
    "build": "npm run gen:midi-manifest && vite build",
    "preview": "vite preview",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
