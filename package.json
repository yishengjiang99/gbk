{
  "name": "sf2-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:midi-manifest": "node scripts/generate-midi-manifest.mjs",
    "dev": "npm run gen:midi-manifest && vite",
    "build": "npm run gen:midi-manifest && vite build",
    "preview": "vite preview",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:sweden:chrome": "PW_VISUAL_CHROME=1 PW_KEEP_CHROME_OPEN=1 playwright test test/e2e/sheet-music-scan.spec.ts --project=chrome-headed --grep \"sweden sheet photo transcribes close to the baseline MIDI\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
