# /etc/gbk-composer.env  (root:www-data, mode 0640). Never commit real values; never put these in Vite env.
COMPOSER_PUBLIC_ORIGIN=https://compose.grepawk.com
# COMPOSER_ENABLED=0 is the off switch (agent socket refuses; sharing/explore keep working read-only).
COMPOSER_ENABLED=1
# Invite / password login: comma-separated "name:code" (or bare codes). No codes = nobody can run the agent.
COMPOSER_ACCESS_CODES=yisheng:CHANGE_ME_LONG_RANDOM
SESSION_SECRET=GENERATE_WITH_openssl_rand_-base64_48
# OpenAI-compatible provider (server-side only)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=YOUR_SERVER_SIDE_KEY
LLM_MODEL=grok-4.20-0309-non-reasoning
LLM_MODELS=grok-4.20-0309-non-reasoning,grok-4.3
LLM_PROVIDER_NAME=xAI
LLM_API_STYLE=chat_completions
LLM_PRICE_INPUT_PER_MTOK=3
LLM_PRICE_OUTPUT_PER_MTOK=15
LLM_PRICE_CACHED_INPUT_PER_MTOK=1.5
# Agent limits
AGENT_MAX_TOOL_STEPS=40
AGENT_MAX_CONCURRENT_RUNS_PER_USER=1
AGENT_TOOL_TIMEOUT_MS=120000
AGENT_MAX_INPUT_CHARS=12000
AGENT_MAX_CONTEXT_TOKENS=32000
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_DAILY_TOKEN_BUDGET=2000000
AGENT_DAILY_COST_BUDGET_USD=5
AGENT_GLOBAL_DAILY_COST_BUDGET_USD=20
# Remote MCP (ChatGPT / Codex plugin): durable compositions, OAuth, headless rendering.
# MCP_ENABLED=0 disables /mcp + /oauth entirely (website unaffected).
MCP_ENABLED=1
# MCP_TEST_AUTH=1 enables Bearer test:<user> / x-gbk-test-user for local tests + MCP Inspector.
# FORBIDDEN in production: the server refuses to boot with NODE_ENV=production + MCP_TEST_AUTH=1.
MCP_TEST_AUTH=0
# MCP renders run in the user's connected Studio tab; the timeout bounds how long the server waits for it.
MCP_RENDER_TIMEOUT_MS=300000
MCP_MAX_RENDER_SECONDS=600
MCP_MAX_RENDERS_PER_DAY=200
MCP_MAX_COMPOSITIONS_PER_USER=500
# OAuth consent transactions (CSRF-protected POST) live this long (seconds).
MCP_CONSENT_TTL_SEC=600
# Signed artifact download URLs (seconds) and on-disk artifact retention (days).
MCP_ARTIFACT_URL_TTL_SEC=900
MCP_ARTIFACT_RETENTION_DAYS=30
# Account-free MCP projects (no login). MCP_GUEST=0 is the off switch (OAuth-only again).
# Keep SESSION_SECRET stable: rotating it invalidates every guest project key.
MCP_GUEST=1
# MCP_GUEST_MAX_SECONDS=180
# MCP_GUEST_MAX_BARS=64
# MCP_GUEST_MAX_EVENTS=20000
# MCP_GUEST_MAX_REVISIONS=100
# MCP_GUEST_RENDERS_PER_DAY=20
# MCP_GUEST_CREATES_PER_DAY=200
# MCP_GUEST_MUTATIONS_PER_DAY=2000
# MCP_GUEST_MAX_COMPOSITIONS=2000
# MCP_GUEST_MAX_STORAGE_BYTES=268435456
# MCP_GUEST_CALLS_PER_MINUTE=60
# MCP_GUEST_CREATES_PER_CLIENT_PER_DAY=20
# GBK_SOUNDFONT_PATH=/var/www/gbk-composer/current/dist/static/GeneralUser-GS.sf2
# CIMD client_id document hosts allowed at /oauth/authorize (SSRF guard); default: chatgpt.com
# MCP_OAUTH_CIMD_HOSTS=chatgpt.com

# Sign-in (Google / GitHub). A provider's button appears only when BOTH its id and secret are set.
# Authorized redirect URIs to register in each provider console:
#   https://compose.grepawk.com/api/auth/google/callback
#   https://compose.grepawk.com/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Per-account daily limits. Accounts younger than ACCOUNT_NEW_DAYS get the smaller "new account" limits.
ACCOUNT_NEW_DAYS=7
AGENT_NEW_ACCOUNT_DAILY_TOKEN_BUDGET=200000
MCP_MAX_RENDERS_PER_DAY=200
MCP_NEW_ACCOUNT_RENDERS_PER_DAY=10

# Account ids (as shown by GET /api/session "user") allowed to read GET /api/admin/client-errors. Comma-separated.
# On the server you can also read browser errors directly: node deploy/client-errors.mjs --help
COMPOSER_ADMIN_USERS=

# Shared token for the finalcut -> composer billing-event hop (POST /api/billing/stripe-events, header
# x-gbk-billing-token). The finalcut Stripe webhook forwards checkout/purchase/renew/cancel/refund events
# with it. Unset = the hop answers 404 and Stripe money events are not recorded here.
# COMPOSE_BILLING_WEBHOOK_TOKEN=

# Public ChatGPT plugin listing URL. Unset = /chatgpt shows "coming soon" (no install button).
# CHATGPT_PLUGIN_URL=
# OpenAI plugin portal domain verification token (served verbatim at /.well-known/openai-apps-challenge).
# OPENAI_APPS_CHALLENGE=
# OpenAI app-review login (one account: openai-reviewer). Off unless both are set. Hash: scrypt$salt$hash (see server/src/routes/reviewer.ts).
# REVIEWER_LOGIN_ENABLED=1
# REVIEWER_PASSWORD_HASH=

# Headless server rendering for MCP clients without a browser (Codex, guests, no Studio tab):
# WAV + MIDI rendered with GBK's own SF2 engine in a worker thread. SERVER_RENDER=0 is the off switch.
SERVER_RENDER=1
# SERVER_RENDER_CONCURRENCY=1
# SERVER_RENDER_MAX_QUEUE=8
# SERVER_RENDER_TIMEOUT_MS=180000
# SERVER_RENDER_WORKER_HEAP_MB=768
# SERVER_RENDER_GUEST_MAX_SECONDS=180
# SERVER_RENDER_ACCOUNT_MAX_SECONDS=300
# SERVER_RENDER_GUEST_PER_HOUR=6
# SERVER_RENDER_ACCOUNT_PER_HOUR=30
# SERVER_RENDER_GUEST_PER_CLIENT_PER_DAY=30

# GBK Composer Pro pricing page (/pricing). Checkout itself runs on grepawk.com (finalcut, product=compose).
# 1 = show Buy buttons (only after Pro limits are actually enforced); default 0 shows the Pro waitlist.
COMPOSE_CHECKOUT_ENABLED=0
COMPOSE_CHECKOUT_ORIGIN=https://grepawk.com
# Ads off switch: 0 = no X/Reddit pixels on /pricing and /pricing/thanks, no click ids forwarded to checkout.
COMPOSE_ADS_ENABLED=1
COMPOSE_X_PIXEL_ID=
COMPOSE_X_EVENT_ID_PURCHASE=
COMPOSE_X_EVENT_ID_START_TRIAL=
COMPOSE_REDDIT_PIXEL_ID=
# Server-side conversions (#130): X Conversions API + Reddit Conversions API v3, sent from the finalcut billing hop
# (POST /api/billing/stripe-events) for purchase / trial_start with the browser pixel's conversion id (dedupe).
# Each platform is off unless ALL of its values are set (and COMPOSE_ADS_ENABLED is not 0). Only a click id and a
# SHA-256 hash of the email are sent; nothing when the buyer's browser had GPC/DNT on. Placeholders only, never commit values.
# X: COMPOSE_X_PIXEL_ID + COMPOSE_X_EVENT_ID_* above, plus X Ads API OAuth 1.0a user-context credentials.
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
# Reddit: COMPOSE_REDDIT_PIXEL_ID above, plus a Conversions API access token (Events Manager -> Conversions API).
REDDIT_CAPI_TOKEN=

# Live Jam (docs/live-jam/architecture.md). JAM_ENABLED=0 switches rooms + signaling off. Independent of the LLM config.
# JAM_ENABLED=1
# JAM_MAX_PARTICIPANTS=4            # 2..4
# JAM_ROOM_TTL_SECONDS=21600
# JAM_INVITE_TTL_SECONDS=86400      # invite links; human codes use JAM_CODE_TTL_SECONDS (default 900, max 3600)
# JAM_RECONNECT_GRACE_SECONDS=60    # disconnected member is removed after this
# JAM_HOST_GRACE_SECONDS=15         # absent host is replaced after this
# JAM_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# JAM_TURN_SHARED_SECRET=           # same value as coturn static-auth-secret; never commit
# JAM_TURN_CREDENTIAL_TTL_SECONDS=3600
# JAM_RELAY_ONLY=0
# JAM_MAX_ROOMS_PER_IDENTITY=3
# JAM_CREATES_PER_HOUR=20  JAM_JOINS_PER_MINUTE=10  JAM_ICE_PER_MINUTE=10  JAM_FRAMES_PER_SECOND=50
