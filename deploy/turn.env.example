# Copy to /etc/gbk-turn.env (mode 600). Used by the `turn` service in docker-compose.yml.
TURN_SHARED_SECRET=            # same value as JAM_TURN_SHARED_SECRET in /etc/gbk-composer.env; 32+ random chars
TURN_EXTERNAL_IP=203.0.113.10  # public IP of the TURN host (or "public/private" when behind 1:1 NAT)
TURN_REALM=turn.example.com
