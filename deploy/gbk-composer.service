[Unit]
Description=GBK Composer agent API + remote MCP (compose.grepawk.com)
After=network.target
# The MCP endpoint (/mcp), OAuth endpoints and the render worker threads run inside this same process:
# worker threads need no extra unit, compositions/artifacts live under COMPOSER_DATA_DIR (already in
# ReadWritePaths), and the SoundFont is read from the release's dist/static. MCP_* env lives in
# /etc/gbk-composer.env (see deploy/compose.env.example).

[Service]
Type=simple
WorkingDirectory=/var/www/gbk-composer/current
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/dist/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8792
Environment=COMPOSER_DATA_DIR=/var/lib/gbk-composer
EnvironmentFile=/etc/gbk-composer.env
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/gbk-composer

[Install]
WantedBy=multi-user.target
